{
  "name": "stc-screen-recorder",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "gate": "node scripts/gate-retry.mjs scripts/gate.mjs",
    "gate:once": "node scripts/gate.mjs",
    "app:build": "node app/build.mjs",
    "app:start": "npm run app:build && electron .",
    "gate:export": "node scripts/gate-retry.mjs scripts/export-gate.mjs",
    "test:capture": "vitest run --config vitest.grant.config.ts",
    "gate:seek": "node scripts/gate-retry.mjs scripts/seek-gate.mjs",
    "gate:identity": "node scripts/gate-retry.mjs scripts/identity-gate.mjs",
    "gate:still": "node scripts/gate-retry.mjs scripts/still-gate.mjs",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "merge": "node scripts/merge-when-green.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "electron": "^43.4.1",
    "esbuild": "^0.28.2",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.4.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "main": "app/dist/main.mjs"
}
